{
  "permissions": {
    "allow": [
      "Bash(uv run pytest*)",
      "Bash(python -m pytest*)",
      "Bash(python -m py_compile*)",
      "Bash(python3 -m py_compile*)",
      "Bash(fly logs*)",
      "Bash(fly status*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(fly secrets *)",
      "Bash(flyctl secrets *)",
      "Bash(gh release create *)"
    ],
    "deny": [
      "Bash(fly deploy *)",
      "Bash(flyctl deploy *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/post_edit_check.py\""
          }
        ]
      }
    ]
  }
}
